# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml for LOCAL development.
# For Streamlit Community Cloud, paste each section into the Secrets editor
# under App Settings → Secrets.
# NEVER commit secrets.toml to Git — it is in .gitignore already.
# ─────────────────────────────────────────────────────────────────────────────

[app]
# SHA-256 hash of your chosen password.
# Generate it by running this in Python:
#   import hashlib; print(hashlib.sha256("yourpassword".encode()).hexdigest())
password_hash = "REPLACE_WITH_SHA256_HASH_OF_YOUR_PASSWORD"

[gcp]
# The ID from your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
spreadsheet_id = "REPLACE_WITH_YOUR_SPREADSHEET_ID"

# Paste the full JSON content of your service account key file here,
# as a single-line string (or use the multi-line syntax below).
service_account_json = """
{
  "type": "service_account",
  "project_id": "YOUR_PROJECT_ID",
  "private_key_id": "YOUR_KEY_ID",
  "private_key": "-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----\n",
  "client_email": "your-service-account@your-project.iam.gserviceaccount.com",
  "client_id": "YOUR_CLIENT_ID",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"
}
"""
